IOBUF PORT "sdram_dq[25]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[26]" SITE "E13";
IOBUF PORT "sdram_dq[26]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[27]" SITE "D15";
IOBUF PORT "sdram_dq[27]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[28]" SITE "E12";
IOBUF PORT "sdram_dq[28]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[29]" SITE "B17";
IOBUF PORT "sdram_dq[29]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[30]" SITE "D14";
IOBUF PORT "sdram_dq[30]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[31]" SITE "D13";
IOBUF PORT "sdram_dq[31]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;

# ---- CN2 (PROVISORIO): somente entradas, vindas do lado B (3,3 V) de SN74LVC4245A em direcao fixa
# A->B. Nao ha placa adaptadora nesta fase; pinos escolhidos nos PMODs da Ext-Board [S3] sem conflito
# com HDMI, SDRAM, LED, serial (J17/H18) e K18. Pulls como no CST da Tang (repouso sem console).
LOCATE COMP "md_d[0]" SITE "C17";   # P3 pmode
IOBUF PORT "md_d[0]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[1]" SITE "B18";   # P3 pmode
IOBUF PORT "md_d[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[2]" SITE "B20";   # P3 pmode
IOBUF PORT "md_d[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[3]" SITE "F20";   # P3 pmode
IOBUF PORT "md_d[3]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[4]" SITE "A18";   # P3 pmode
IOBUF PORT "md_d[4]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[5]" SITE "A19";   # P3 pmode
IOBUF PORT "md_d[5]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[6]" SITE "B19";   # P3 pmode
IOBUF PORT "md_d[6]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[7]" SITE "D20";   # P3 pmode
IOBUF PORT "md_d[7]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[8]" SITE "D1";   # P3 pmodf
IOBUF PORT "md_d[8]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[9]" SITE "C1";   # P3 pmodf
IOBUF PORT "md_d[9]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[10]" SITE "C2";   # P3 pmodf
IOBUF PORT "md_d[10]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[11]" SITE "E3";   # P3 pmodf
IOBUF PORT "md_d[11]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[12]" SITE "E2";   # P3 pmodf
IOBUF PORT "md_d[12]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[13]" SITE "D2";   # P3 pmodf
IOBUF PORT "md_d[13]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[14]" SITE "B1";   # P3 pmodf
IOBUF PORT "md_d[14]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_d[15]" SITE "A3";   # P3 pmodf
IOBUF PORT "md_d[15]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_a[1]" SITE "H4";   # P4 pmodg
IOBUF PORT "md_a[1]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_a[2]" SITE "G3";   # P4 pmodg
IOBUF PORT "md_a[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_a[3]" SITE "F1";   # P4 pmodg
IOBUF PORT "md_a[3]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_fdc_n" SITE "F2";   # P4 pmodg
IOBUF PORT "md_fdc_n" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_fdwr_n" SITE "H3";   # P4 pmodg
IOBUF PORT "md_fdwr_n" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_cas0_n" SITE "F3";   # P4 pmodg
IOBUF PORT "md_cas0_n" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "md_fres" SITE "E4";   # P4 pmodg
IOBUF PORT "md_fres" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

# ---- audio (PROVISORIO) P5 pmodi:0..4 - I2S para DAC/PCM1808; adc_mclk e o clock fracionario
# EXPERIMENTAL (jitter, ver AUDIO_CLOCK_REPORT.md). D16 (pmodi:5) evitado (divergencia SDRAM acima).
LOCATE COMP "i2s_bck" SITE "D18";
IOBUF PORT "i2s_bck" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "i2s_ws" SITE "G5";
IOBUF PORT "i2s_ws" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "i2s_dout" SITE "F5";
IOBUF PORT "i2s_dout" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "adc_mclk" SITE "E5";
IOBUF PORT "adc_mclk" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "adc_dout" SITE "D17";
IOBUF PORT "adc_dout" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
