# MD-VDPX ECP5-P1 - Colorlight i9 v7.2 (LFE5U-45F-6BG381C) on the i5/i9 Ext-Board
# Fontes (ver HDMI_PINOUT.md / HDMI_EXT_BOARD.md):
#  [S1] wuxx/Colorlight-FPGA-Projects schematic/i5-i9-extboard.pdf (Altium, 2020-10-29): nota HDx/HCK -> esferas,
#       HDMI1 com C6..C13 = 0,1 uF em serie; CEC/SCL/SDA/HOTPLUG sem ligacao; +5V do conector = 5V da placa
#  [S2] wuxx colorlight_i9_v7.x.md (clock P3, LED L2, SDRAM, flash)
#  [S3] litex-boards platforms/colorlight_i5.py (i9 rev 7.2: gpdi LVCMOS33D DRIVE=4, SDRAM, PMODs)
#  [S4] prjtrellis-db ECP5/LFE5U-45F/iodb.json (banco e par diferencial de cada esfera)
# Todas as entradas/saidas LVCMOS33: os projetos de referencia [S3] usam VCCIO 3,3 V em todos os bancos.
# O esquema do modulo i9 (VCCIO por banco) NAO e publico: tensao dos bancos = inferida, medir na placa.

# ---- clock 25 MHz [S2]
LOCATE COMP "clk25" SITE "P3";
IOBUF PORT "clk25" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk25" 25 MHZ;

# ---- HDMI (Ext-Board HDMI1) [S1][S3]. Pares verdadeiros A/B do banco 2 [S4]; so o pino P e declarado,
# o N (complementar) e implicito em LVCMOS33D. Lane 0 = azul, 1 = verde, 2 = vermelho, 3 = clock.
LOCATE COMP "gpdi_dp[0]" SITE "G19";   # D0 (HD0_P/HD0_N, PR20A/B), N = H20
IOBUF PORT "gpdi_dp[0]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "gpdi_dp[1]" SITE "E20";   # D1 (HD1_P/HD1_N, PR17A/B), N = F19
IOBUF PORT "gpdi_dp[1]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "gpdi_dp[2]" SITE "C20";   # D2 (HD2_P/HD2_N, PR14A/B), N = D19
IOBUF PORT "gpdi_dp[2]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "gpdi_dp[3]" SITE "J19";   # CLK (HCK_P/HCK_N, PR23A/B), N = K19
IOBUF PORT "gpdi_dp[3]" IO_TYPE=LVCMOS33D DRIVE=4;

# ---- LED do modulo (ativo em 0; compartilhado com o pino 41 do SODIMM / pmodc:3) [S2][S3]
LOCATE COMP "led_n" SITE "L2";
IOBUF PORT "led_n" IO_TYPE=LVCMOS33 DRIVE=4;

# ---- SDRAM M12L64322A [S2][S3]: CS#=GND, CKE=3V3, DQM0-3=GND no modulo (sem pinos FPGA).
# Ordem de DQ do [S2]; o [S3] usa outra permutacao do mesmo conjunto de 32 esferas (sem DQM, a
# permutacao de bits e transparente). dq[27] = D15 ([S2][S3]); amaranth_boards (src/ do [S2]) diz D16,
# que e pino de PMOD (pmodi:5) - divergencia registrada, D16 nao e usado aqui.
LOCATE COMP "sdram_clk" SITE "B9";
IOBUF PORT "sdram_clk" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_ras_n" SITE "B10";
IOBUF PORT "sdram_ras_n" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_cas_n" SITE "A9";
IOBUF PORT "sdram_cas_n" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_we_n" SITE "A10";
IOBUF PORT "sdram_we_n" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_ba[0]" SITE "B11";
IOBUF PORT "sdram_ba[0]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_ba[1]" SITE "C8";
IOBUF PORT "sdram_ba[1]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[0]" SITE "B13";
IOBUF PORT "sdram_a[0]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[1]" SITE "C14";
IOBUF PORT "sdram_a[1]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[2]" SITE "A16";
IOBUF PORT "sdram_a[2]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[3]" SITE "A17";
IOBUF PORT "sdram_a[3]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[4]" SITE "B16";
IOBUF PORT "sdram_a[4]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[5]" SITE "B15";
IOBUF PORT "sdram_a[5]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[6]" SITE "A14";
IOBUF PORT "sdram_a[6]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[7]" SITE "A13";
IOBUF PORT "sdram_a[7]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[8]" SITE "A12";
IOBUF PORT "sdram_a[8]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[9]" SITE "A11";
IOBUF PORT "sdram_a[9]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_a[10]" SITE "B12";
IOBUF PORT "sdram_a[10]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8;
LOCATE COMP "sdram_dq[0]" SITE "B6";
IOBUF PORT "sdram_dq[0]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[1]" SITE "A5";
IOBUF PORT "sdram_dq[1]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[2]" SITE "A6";
IOBUF PORT "sdram_dq[2]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[3]" SITE "A7";
IOBUF PORT "sdram_dq[3]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[4]" SITE "C7";
IOBUF PORT "sdram_dq[4]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[5]" SITE "B8";
IOBUF PORT "sdram_dq[5]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[6]" SITE "B5";
IOBUF PORT "sdram_dq[6]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[7]" SITE "A8";
IOBUF PORT "sdram_dq[7]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[8]" SITE "D8";
IOBUF PORT "sdram_dq[8]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[9]" SITE "D7";
IOBUF PORT "sdram_dq[9]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[10]" SITE "E8";
IOBUF PORT "sdram_dq[10]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[11]" SITE "D6";
IOBUF PORT "sdram_dq[11]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[12]" SITE "C6";
IOBUF PORT "sdram_dq[12]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[13]" SITE "D5";
IOBUF PORT "sdram_dq[13]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[14]" SITE "E7";
IOBUF PORT "sdram_dq[14]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[15]" SITE "C5";
IOBUF PORT "sdram_dq[15]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[16]" SITE "C10";
IOBUF PORT "sdram_dq[16]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[17]" SITE "D9";
IOBUF PORT "sdram_dq[17]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[18]" SITE "E11";
IOBUF PORT "sdram_dq[18]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[19]" SITE "D11";
IOBUF PORT "sdram_dq[19]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[20]" SITE "C11";
IOBUF PORT "sdram_dq[20]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[21]" SITE "D12";
IOBUF PORT "sdram_dq[21]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[22]" SITE "E9";
IOBUF PORT "sdram_dq[22]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[23]" SITE "C12";
IOBUF PORT "sdram_dq[23]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
LOCATE COMP "sdram_dq[24]" SITE "E14";
IOBUF PORT "sdram_dq[24]" IO_TYPE=LVCMOS33 SLEWRATE=FAST DRIVE=8 PULLMODE=NONE;
